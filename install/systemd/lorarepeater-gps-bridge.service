[Unit]
Description=u-blox GPS I2C to pty bridge (RAK2287 GPS at i2c-1 0x42)
Before=gpsd.service lora-pkt-fwd.service
After=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/opt/lorarepeater/venv/bin/lorarepeater gps-bridge --i2c /dev/i2c-1 --addr 0x42 --link /run/lorarepeater/gps-pktfwd --link /run/lorarepeater/gps-gpsd
Restart=always
RestartSec=3
RuntimeDirectory=lorarepeater
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
